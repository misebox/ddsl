# Which side writes what.
# The side that holds the foreign key writes belongs_to.
# The side being pointed at writes has_many or has_one.
# fk=, alias= and via= only appear when names would collide.

nouns {
  user      users      "A person who signs in"
  message   messages   "A direct message between two users"
  category  categories "A grouping, possibly nested"
  profile   profiles   "Extra details about one user"
  role      roles      "A permission that can be granted"
  post      posts      "Something a user wrote"
  favorite  favorites  "A user liking a post"
  user_role user_roles "A permission granted to a user"
}

mixin base {
  column id         type=serial      comment="Primary key"
  column created_at type=timestamptz default=eval(now()) comment="When the row was created"
  pk id
}

table user {
  comment "A person who signs in"
  use base
  column name type=text comment="Shown to other users"

  # Two references arrive from the same table, so via= picks which one.
  has_many message via="sender_id"   alias=noun("sent", message)
  has_many message via="receiver_id" alias=noun("received", message)

  # The far side of a one-to-one is has_one. Its default name is singular.
  has_one profile
}

# Two references to one table. Without fk= both would want user_id.
table message {
  comment "A direct message between two users"
  use base
  belongs_to user fk="sender_id"   alias="sender"   comment="Who sent it"
  belongs_to user fk="receiver_id" alias="receiver" comment="Who received it"
  column body type=text comment="What was written"
}

table profile {
  comment "Extra details about one user"
  use base
  unique_belongs_to user comment="Whose profile this is"
  column bio type=text null=true comment="Free text the user wrote"
}

# A tree. Roots have no parent, so the key has to accept null.
table category {
  comment "A grouping, possibly nested"
  use base
  belongs_to category fk="parent_id" alias="parent" comment="The category above this one"
  override parent_id null=true
  column name type=text comment="Shown in navigation"
  has_many category via="parent_id" alias="children"
}

table post {
  comment "Something a user wrote"
  use base
  belongs_to user comment="Who wrote it"
  belongs_to category comment="Where it is filed"
  override category_id null=true
  column title type=text comment="Shown in listings"
}

table role {
  comment "A permission that can be granted"
  use base
  column name type=text comment="What the permission allows"
  index name unique
}

# A join table that carries its own columns is an ordinary table
# with two belongs_to.
table user_role {
  comment "A permission granted to a user"
  belongs_to user comment="Who was granted it"
  belongs_to role comment="What they were granted"
  column granted_at type=timestamptz default=eval(now()) comment="When it was granted"
  pk [user_id, role_id]
}

# When the join carries nothing, associate is enough. name= sets the noun.
associate(user, post, name=favorite, comment="A user liking a post")
