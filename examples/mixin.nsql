# mixin は1テーブルの中に閉じた規約をまとめる。
# use は書いた位置に展開されるので、列の並びは読んだとおりになる。

nouns {
  user     users      "ユーザー"
  article  articles   "記事"
  category categories "カテゴリ"
}

mixin identity {
  column id type=serial comment="主キー"
  pk id
}

mixin timestamps {
  column created_at type=timestamptz default=eval(now()) comment="作成日時"
  column updated_at type=timestamptz default=eval(now()) on_update=eval(now()) comment="更新日時"
}

mixin publishable {
  column status       type=text                  comment="公開状態"
  column published_at type=timestamptz null=true comment="公開日時"
  index status
  index published_at
}

# mixin は他の mixin を取り込める。
mixin base {
  use identity
  use timestamps
}

table user {
  comment "ユーザー"
  use base
  column email type=text comment="ログインID"
  index email unique
}

table article {
  comment "記事"
  use base
  use publishable

  # 公開日で一覧しないので、この索引だけ外す。列は残る。
  except index published_at

  belongs_to user comment="著者"
  column title type=text comment="表題"
}

# 取り込んだものは調整できる。
# override は指定した属性だけを差し替え、他は mixin のまま残す。
table category {
  comment "カテゴリ"
  use base

  # 主キーを bigserial に。comment は mixin の値のまま残る。
  override id type=bigserial

  # 更新しない台帳なので更新日時を外す。
  except updated_at

  column name type=text comment="カテゴリ名"
  index name unique
}
