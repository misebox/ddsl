# A mixin holds conventions that stay inside one table.
# `use` expands where it is written, so columns land in reading order.

nouns {
  user     users      "A person who signs in"
  article  articles   "A piece of writing"
  category categories "A grouping for articles"
}

mixin identity {
  column id type=serial comment="Primary key"
  pk id
}

mixin timestamps {
  column created_at type=timestamptz default=eval(now()) comment="When the row was created"
  column updated_at type=timestamptz default=eval(now()) on_update=eval(now()) comment="When it last changed"
}

mixin publishable {
  column status       type=text                  comment="Draft, scheduled or published"
  column published_at type=timestamptz null=true comment="When it went public"
  index status
  index published_at
}

# Mixins compose.
mixin base {
  use identity
  use timestamps
}

table user {
  comment "A person who signs in"
  use base
  column email type=text comment="Used to sign in"
  index email unique
}

table article {
  comment "A piece of writing"
  use base
  use publishable

  # Articles are never listed by date, so drop that index. The column stays.
  except index published_at

  belongs_to user comment="Who wrote it"
  column title type=text comment="Shown in listings"
}

table category {
  comment "A grouping for articles"
  use base

  # Widen the key. Everything else about the column stays as the mixin set it.
  override id type=bigserial

  # A category is never edited in place, so it has no updated_at.
  except updated_at

  column name type=text comment="Shown in navigation"
  index name unique
}
