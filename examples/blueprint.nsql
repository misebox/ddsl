# A mixin is reused across tables and gives you the inside of one.
# A blueprint is reused across nouns and gives you the tables themselves:
# a parameterised group of table blocks, applied to a noun.

nouns {
  account      "A person who signs in"
  post      "Something an account wrote"
  product   "Something for sale"
  approval  "A request to publish"
  step      "One stage of a request"
  note      "A remark left on a stage"
}

mixin base {
  column id         type=serial      comment="Primary key"
  column created_at type=timestamptz default=eval(now()) comment="When the row was created"
  pk id
}

blueprint approvable target {
  # The identifier is a local handle; `name` decides the noun. A table can be
  # named after another one, so each name builds on the one before it.
  table t_approval {
    name noun(target, approval)               # post_approvals
    comment "A request to publish a ${target}"
    use base
    belongs_to target comment="What is being approved"
    belongs_to account fk="requester_id" alias="requester" comment="Who asked"
    column status type=text comment="Where the request stands"
    index status
  }

  table t_step {
    name noun(t_approval, step)               # post_approval_steps
    comment "One stage of approving a ${target}"
    use base
    belongs_to t_approval comment="Which request"
    belongs_to account fk="approver_id" alias="approver" comment="Who decides"
    column position type=integer comment="Order within the request"
    column decision type=text    comment="What they decided"
    index [approver_id, decision]
  }

  table t_note {
    name noun(t_step, note)                   # post_approval_step_notes
    comment "A remark left while approving a ${target}"
    use base
    belongs_to t_step comment="Which stage"
    belongs_to account   comment="Who left it"
    column body type=text comment="What they wrote"
  }
}

table account {
  comment "A person who signs in"
  use base
  column name type=text comment="Shown to other accounts"
}

table post {
  comment "Something an account wrote"
  use base
  belongs_to account comment="Who wrote it"
  column title type=text comment="Shown in listings"
}

table product {
  comment "Something for sale"
  use base
  column name type=text comment="Shown to shoppers"
}

# The same mechanism on two different nouns. Names and comments follow target.
apply_blueprint(approvable, post)
apply_blueprint(approvable, product)
