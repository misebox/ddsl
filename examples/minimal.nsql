# 最小の構成。

nouns {
  user users "ユーザー"
  post posts "投稿"
}

mixin base {
  column id         type=serial      comment="主キー"
  column created_at type=timestamptz default=eval(now()) comment="作成日時"
  pk id
}

table user {
  comment "ユーザー"
  use base
  column email type=text comment="ログインID"
  index email unique
  has_many post
}

table post {
  comment "投稿"
  use base
  belongs_to user comment="投稿者"
  column title type=text comment="表題"
}
