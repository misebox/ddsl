# What it looks like at a realistic size.
# The conventions sit in mixins and naming, so each table definition
# carries only what makes that table different.

nouns {
  customer    "Someone who buys"
  address     "Somewhere a purchase can be delivered"
  category    "A grouping for products"
  product     "Something for sale"
  variant     "One buyable form of a product"
  purchase       "A purchase a customer placed"
  purchase_item  "One line of a purchase"
  payment     "Money taken for a purchase"
  shipment    "A parcel sent for a purchase"
  review      "What a customer thought of a product"
}

mixin base {
  column id         type=serial      comment="Primary key"
  column created_at type=timestamptz default=eval(now()) comment="When the row was created"
  column updated_at type=timestamptz default=eval(now()) on_update=eval(now()) comment="When it last changed"
  pk id
}

# Money is held the same way everywhere it appears.
mixin money {
  column amount   type=integer comment="In the smallest unit of the currency"
  column currency type=char    default="JPY" comment="ISO 4217 code"
}

table customer {
  comment "Someone who buys"
  use base
  column email type=text comment="Used to sign in"
  column name  type=text comment="Shown on receipts"
  index email unique
}

table address {
  comment "Somewhere a purchase can be delivered"
  use base
  belongs_to customer comment="Whose address this is"
  column postal_code type=text comment="Used to work out shipping"
  column line        type=text comment="The rest of the address"
  index [customer_id, postal_code]
}

table category {
  comment "A grouping for products"
  use base
  belongs_to category fk="parent_id" alias="parent" comment="The category above this one"
  override parent_id null=true
  column name type=text comment="Shown in navigation"
  index name unique
  has_many category via="parent_id" alias="children"
}

table product {
  comment "Something for sale"
  use base
  belongs_to category comment="Where it is filed"
  column name        type=text comment="Shown to shoppers"
  column description type=text null=true comment="Longer copy for the product page"
  index name
}

# Colour and size variations of one product. Stock lives here.
table variant {
  comment "One buyable form of a product"
  use base
  use money
  belongs_to product comment="Which product this varies"
  column sku   type=text    comment="How the warehouse refers to it"
  column stock type=integer default=0 comment="How many are on hand"
  index sku unique
}

table purchase {
  comment "A purchase a customer placed"
  use base
  belongs_to customer comment="Who placed it"
  belongs_to address  comment="Where it goes"
  column status     type=text        comment="Where the purchase stands"
  column placed_at type=timestamptz default=eval(now()) comment="When it was placed"
  index [customer_id, placed_at]
  index status
}

table purchase_item {
  comment "One line of a purchase"
  use base
  use money
  belongs_to purchase   comment="Which purchase"
  belongs_to variant comment="What was bought"
  column quantity type=integer comment="How many"
  index [purchase_id, variant_id] unique
}

table payment {
  comment "Money taken for a purchase"
  use base
  use money
  unique_belongs_to purchase comment="Which purchase was paid for"
  column method  type=text        comment="How it was paid"
  column paid_at type=timestamptz null=true comment="When it cleared"
}

table shipment {
  comment "A parcel sent for a purchase"
  use base
  belongs_to purchase comment="Which purchase it fulfils"
  column carrier         type=text           comment="Who is carrying it"
  column tracking_number type=text null=true comment="What the carrier calls it"
  column shipped_at      type=timestamptz null=true comment="When it left"
  index tracking_number
}

table review {
  comment "What a customer thought of a product"
  use base
  belongs_to product  comment="What was reviewed"
  belongs_to customer comment="Who reviewed it"
  column rating type=integer comment="One to five"
  column body   type=text null=true comment="What they wrote"
  index [product_id, customer_id] unique
}
