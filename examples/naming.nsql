# Change the conventions and every generated name changes with them.
# The choice between idx_ and ix_ is settled here, once.

naming {
  # Plural table names. The default is singular.
  table_name = plural

  # Foreign keys become author_ref. The default is ${singular(table)}_id.
  foreign_key = "${singular(table)}_ref"

  # Index names. The defaults start with idx_ and uq_.
  # short(...) takes the noun's short form, for names that would otherwise
  # run past the 63 bytes PostgreSQL keeps.
  index = "${short(table)}_${columns}_ix"
  unique_index = "${short(table)}_${columns}_uq"

  # What joins column names inside an index name. The default is "_".
  column_separator = "__"

  # What joins the parts of a compound noun. The default is "_".
  noun_separator = "_"
}

constraints {
  # What a column means when null= is left out. Setting this to true
  # makes omission mean nullable.
  null_default = true

  # Referential actions. Both default to cascade.
  on_delete_default = restrict
  on_update_default = no_action

  # Whether foreign key columns get an index. The default is true.
  foreign_key_index = false
}

nouns {
  # short= is the abbreviation. Left out, it is the singular form.
  author   short=auth  "Someone who writes articles"
  article  short=art   "A piece of writing"
  tag                  "A label attached to articles"
}

mixin base {
  column id type=serial comment="Primary key"
  pk id
}

table author {
  comment "Someone who writes articles"
  use base
  # With null_default = true, anything unmarked is nullable.
  column name type=text null=false comment="Required, so it says so"
  column bio  type=text comment="Left open, so it is nullable"
}

table article {
  comment "A piece of writing"
  use base
  belongs_to author comment="Who wrote it"
  column title type=text null=false comment="Shown in listings"
  column body  type=text comment="The writing itself"
  index [author_ref, title] unique
}

table tag {
  comment "A label attached to articles"
  use base
  column name type=text null=false comment="Shown as a chip"
  index name unique
}

associate(article, tag)
