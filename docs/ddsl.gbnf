# DDSL grammar (GBNF / llama.cpp constrained decoding)
# 対応する仕様: docs/spec.md

root ::= nls? (item (nls item)*)? nls?

item ::=
      naming-block
    | constraints-block
    | entities-block
    | mixin-block
    | blueprint-block
    | table-block
    | associate
    | apply-blueprint

# ---------- 設定ブロック ----------

naming-block ::= "naming" sp "{" nls (assign nls)* "}"
constraints-block ::= "constraints" sp "{" nls (assign nls)* "}"

assign ::= sp ident sp "=" sp value

entities-block ::= "entities" sp "{" nls (entity nls)* "}"
entity ::= sp ident sp1 ident sp1 string

# ---------- mixin ----------

mixin-block ::= "mixin" sp1 ident comment-attr? sp "{" nls (member nls)* "}"

# ---------- table ----------

table-block ::= "table" sp1 ident comment-attr? sp "{" nls (member nls)* "}"

member ::= sp (
      column-stmt
    | pk-stmt
    | index-stmt
    | use-stmt
    | override-stmt
    | except-index-stmt
    | except-stmt
    | unique-belongs-to-stmt
    | belongs-to-stmt
    )

column-stmt ::= "column" sp1 ident (sp1 attr)*
pk-stmt ::= "pk" sp1 col-list
index-stmt ::= "index" sp1 col-list (sp1 "unique")?
use-stmt ::= "use" sp1 ident
override-stmt ::= "override" sp1 ident (sp1 attr)+
except-index-stmt ::= "except" sp1 "index" sp1 col-list
except-stmt ::= "except" sp1 name-list
belongs-to-stmt ::= "belongs_to" sp1 ident
unique-belongs-to-stmt ::= "unique_belongs_to" sp1 ident

attr ::= attr-key sp "=" sp value
attr-key ::= "type" | "null" | "default" | "on_update" | "comment"
comment-attr ::= sp1 "comment" sp "=" sp string

col-list ::= ident | ident-list
name-list ::= ident | ident-list
ident-list ::= "[" sp ident (sp "," sp ident)* sp "]"

# ---------- blueprint ----------

blueprint-block ::= "blueprint" sp1 ident (sp1 ident)* comment-attr? sp "{" nls (bp-member nls)* "}"
bp-member ::= sp (let-stmt | table-block)
let-stmt ::= "let" sp1 ident sp "=" sp expr

# ---------- マクロ ----------

associate ::= "associate" sp "(" sp ident sp "," sp ident sp ")"
apply-blueprint ::= "apply_blueprint" sp "(" sp ident (sp "," sp ident)+ sp ")"

# ---------- 値 ----------

value ::= eval-call | fn-call | string | list | ident
expr ::= fn-call | string | ident

fn-call ::= fn-name sp "(" sp ident (sp "," sp ident)* sp ")"
fn-name ::= "name_join" | "singular" | "plural"

eval-call ::= "eval" sp "(" sql-expr ")"
sql-expr ::= sql-atom*
sql-atom ::= [^()] | "(" sql-expr ")"

list ::= "[" ws (ident (ws "," ws ident)*)? ws "]"

string ::= "\"" str-char* "\""
str-char ::= [^"\\] | "\\" [^]

ident ::= [a-zA-Z_] [a-zA-Z0-9_]*

# ---------- 空白 ----------

sp ::= [ \t]*
sp1 ::= [ \t]+
ws ::= [ \t\r\n]*
comment ::= "#" [^\n]*
nl ::= sp comment? "\r"? "\n"
nls ::= nl+
