{
  "name": "nounsql",
  "displayName": "NounSQL",
  "description": "DB設計用DSLの syntax highlight と language server",
  "version": "0.1.0",
  "engines": { "vscode": "^1.90.0" },
  "categories": ["Programming Languages"],
  "activationEvents": ["onLanguage:nounsql"],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "nounsql",
        "aliases": ["NounSQL"],
        "extensions": [".nsql"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "nounsql",
        "scopeName": "source.nounsql",
        "path": "./syntaxes/nounsql.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "NounSQL",
      "properties": {
        "nounsql.server.path": {
          "type": "string",
          "default": "nounsql-lsp",
          "description": "nounsql-lsp 実行ファイルのパス"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ."
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.7.2"
  }
}
