#!/usr/bin/env bash
#
# ドキュメントサイトをローカルで見る。
#
#   bin/preview                開発サーバを立てる。変更は即座に反映される
#   bin/preview --port 8080    ポートを変える
#   bin/preview --build        本番と同じものをビルドして配信する
#   bin/preview --no-wasm      WebAssembly を作り直さない
#
# 停止は Ctrl-C。
set -euo pipefail

cd "$(dirname "$0")/.."

PORT=4321
MODE=dev
BUILD_WASM=yes
WASM_OUT=crates/nounsql-wasm/pkg

usage() {
  sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//'
  exit 1
}

die() {
  echo "error: $*" >&2
  exit 1
}

log() {
  echo "  $*"
}

while [ $# -gt 0 ]; do
  case "$1" in
    --port)    PORT=${2:-}; [ -n "$PORT" ] || die "--port に番号が要る"; shift 2 ;;
    --build)   MODE=build; shift ;;
    --no-wasm) BUILD_WASM=no; shift ;;
    -h|--help) usage ;;
    *)         die "知らないオプション: $1" ;;
  esac
done

command -v bun >/dev/null || die "bun が無い"

# サイトは pkg を file: 依存として参照するので、無いと install も通らない。
if [ "$BUILD_WASM" = yes ] || [ ! -f "$WASM_OUT/nounsql_wasm_bg.wasm" ]; then
  command -v wasm-pack >/dev/null || die "wasm-pack が無い。--no-wasm で飛ばせる"
  log "WebAssembly をビルドする"
  wasm-pack build crates/nounsql-wasm --target web --out-dir pkg --release >/dev/null 2>&1 \
    || die "wasm-pack build に失敗した"
fi

if [ ! -d site/node_modules ]; then
  log "依存をインストールする"
  (cd site && bun install >/dev/null)
fi

if [ "$MODE" = build ]; then
  log "ビルドする"
  (cd site && bun run build >/dev/null)
  log "http://127.0.0.1:$PORT/  （Ctrl-C で止める）"
  exec bun run --cwd site vite preview --port "$PORT" --strictPort --outDir ../dist
fi

log "http://127.0.0.1:$PORT/  （Ctrl-C で止める）"
exec bun run --cwd site vite --port "$PORT" --strictPort
