#!/usr/bin/env bash
#
# リリースする。
#
#   bin/release patch            0.1.0 -> 0.1.1
#   bin/release minor            0.1.0 -> 0.2.0
#   bin/release major            0.1.0 -> 1.0.0
#   bin/release 0.2.0            バージョンを直接指定する
#   bin/release patch --check    検査だけ行い、何も書き換えない
#   bin/release patch --yes      確認を省く
#
#   bin/release patch --skip-npm npm への公開を飛ばす
# crates.io への公開には CARGO_REGISTRY_TOKEN が要る。cargo が直接読む変数。
# npm への公開には npm login が要る。
# タグを push すると CI がバイナリをビルドして GitHub Release を作る。
set -euo pipefail

cd "$(dirname "$0")/.."

# 依存の順に公開する。
CRATES=(nounsql-core nounsql-lsp nounsql)

# npm に出すパッケージ名と、その元になる crate。
NPM_PACKAGE=nounsql
WASM_CRATE=crates/nounsql-wasm

usage() {
  sed -n '2,14p' "$0" | sed 's/^# \{0,1\}//'
  exit 1
}

die() {
  echo "error: $*" >&2
  exit 1
}

step() {
  echo
  echo "==> $*"
}

confirm() {
  [ "$ASSUME_YES" = yes ] && return 0
  local reply
  read -r -p "$1 [y/N] " reply
  [ "$reply" = y ] || [ "$reply" = Y ] || die "中止した"
}

# Cargo.toml の [workspace.package] version。
current_version() {
  sed -n 's/^version = "\([^"]*\)"$/\1/p' Cargo.toml | head -1
}

# major / minor / patch のどれかを上げた版を返す。
# プレリリースが付いていれば落とす。patch はプレリリースを確定させるだけにする。
bump_version() {
  local current=$1 kind=$2
  local core=${current%%-*}
  local pre=""
  [ "$core" = "$current" ] || pre=${current#*-}

  [[ "$core" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] \
    || die "Cargo.toml のバージョンを解釈できない: $current"

  local major minor patch
  IFS=. read -r major minor patch <<< "$core"
  case "$kind" in
    major) major=$((major + 1)); minor=0; patch=0 ;;
    minor) minor=$((minor + 1)); patch=0 ;;
    patch) [ -n "$pre" ] || patch=$((patch + 1)) ;;
  esac
  echo "$major.$minor.$patch"
}

# GNU sed と BSD sed の -i の差を吸収する。
replace_in_file() {
  local pattern=$1 file=$2 tmp
  tmp=$(mktemp)
  sed "$pattern" "$file" > "$tmp"
  mv "$tmp" "$file"
}

# crates.io にそのバージョンが載っているか。
is_published() {
  curl -sf -o /dev/null -A nounsql-release "https://crates.io/api/v1/crates/$1/$2"
}

wait_for_index() {
  local crate=$1 version=$2
  for _ in $(seq 30); do
    if is_published "$crate" "$version"; then
      echo "  $crate $version を確認した"
      return 0
    fi
    sleep 10
  done
  die "$crate $version がレジストリに現れない"
}

[ $# -ge 1 ] || usage
CURRENT=$(current_version)
[ -n "$CURRENT" ] || die "Cargo.toml からバージョンを読めない"

case "$1" in
  major|minor|patch) VERSION=$(bump_version "$CURRENT" "$1") ;;
  *)                 VERSION=$1 ;;
esac
CHECK_ONLY=no
ASSUME_YES=no
SKIP_NPM=no
for arg in "${@:2}"; do
  case "$arg" in
    --check)    CHECK_ONLY=yes ;;
    --yes)      ASSUME_YES=yes ;;
    --skip-npm) SKIP_NPM=yes ;;
    *)          die "知らないオプション: $arg" ;;
  esac
done
TAG="v$VERSION"

[[ "$VERSION" =~ ^[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.-]+)?$ ]] \
  || die "バージョンが semver ではない: $VERSION"
# 据え置きも許す。初回リリースは現在の版をそのまま出す。
# 再リリースはタグの存在で弾く。
if [ "$VERSION" = "$CURRENT" ]; then
  echo "バージョン ${VERSION}（据え置き）"
else
  echo "$CURRENT -> $VERSION"
fi

step "前提の確認"
command -v cargo >/dev/null || die "cargo が無い"
command -v git   >/dev/null || die "git が無い"
if [ "$CHECK_ONLY" = no ]; then
  command -v gh >/dev/null || die "gh が無い"
  [ -n "${CARGO_REGISTRY_TOKEN:-}" ] \
    || die "CARGO_REGISTRY_TOKEN が未設定。crates.io の API トークンを入れる"
  if [ "$SKIP_NPM" = no ]; then
    command -v npm >/dev/null || die "npm が無い。--skip-npm で飛ばせる"
    command -v wasm-pack >/dev/null || die "wasm-pack が無い。--skip-npm で飛ばせる"
    npm whoami >/dev/null 2>&1 || die "npm にログインしていない。npm login するか --skip-npm"
  fi
fi
[ -z "$(git status --porcelain)" ] || die "コミットされていない変更がある"
git rev-parse "$TAG" >/dev/null 2>&1 && die "タグ $TAG は既にある"
echo "ok"

step "フォーマット"
cargo fmt --check

step "lint"
cargo clippy --all-targets -- -D warnings

step "テスト"
cargo test

step "サンプルの DDL が最新か"
cargo run -q -p nounsql -- sql examples/sample.nsql > examples/sample.sql
git diff --quiet examples/sample.sql \
  || die "examples/sample.sql が古い。生成し直してコミットする"
echo "ok"

step "WebAssembly がビルドできるか"
cargo check -q -p nounsql-wasm --target wasm32-unknown-unknown
echo "ok"

step "ドキュメントサイトがビルドできるか"
if command -v bun >/dev/null; then
  (cd site && bun install --silent >/dev/null && bun run build >/dev/null)
  echo "ok"
else
  echo "  bun が無いので飛ばす"
fi

step "パッケージの中身"
for crate in "${CRATES[@]}"; do
  echo "  $crate: $(cargo package --list -p "$crate" | wc -l | tr -d ' ') files"
done

step "公開済みかどうか"
for crate in "${CRATES[@]}"; do
  if is_published "$crate" "$VERSION"; then
    echo "  $crate $VERSION: 公開済み（飛ばす）"
  else
    echo "  $crate $VERSION: 未公開"
  fi
done

if [ "$CHECK_ONLY" = yes ]; then
  step "検査のみ完了。何も書き換えていない"
  exit 0
fi

step "バージョンを $VERSION にする"
replace_in_file "s/^version = \"[^\"]*\"$/version = \"$VERSION\"/" Cargo.toml
replace_in_file \
  "s|^nounsql-core = { path = \"crates/nounsql-core\", version = \"[^\"]*\" }|nounsql-core = { path = \"crates/nounsql-core\", version = \"$VERSION\" }|" \
  Cargo.toml
cargo update --workspace --quiet

step "コミットとタグ"
if git diff --quiet Cargo.toml Cargo.lock; then
  echo "  バージョンは据え置き。コミットは作らない"
else
  git --no-pager diff --stat Cargo.toml Cargo.lock
  git add Cargo.toml Cargo.lock
  git commit -q -m "Release $TAG"
fi
git tag -a "$TAG" -m "$TAG"
echo "  $(git log --oneline -1) / $TAG"

npm_note=""
[ "$SKIP_NPM" = no ] && npm_note=" / npm $NPM_PACKAGE"

cat <<EOF

ここから先は取り消せない。crates.io は unpublish できず、yank しかできない。

  公開するもの: ${CRATES[*]}$npm_note  $VERSION
  push するもの: $(git rev-parse --abbrev-ref HEAD) と $TAG
EOF
confirm "続ける？"

step "crates.io へ公開"
for crate in "${CRATES[@]}"; do
  if is_published "$crate" "$VERSION"; then
    echo "  $crate: 公開済み。飛ばす"
    continue
  fi
  echo "  $crate を公開する"
  cargo publish -p "$crate"
  # 後続の crate がこれを依存として解決できるまで待つ。
  [ "$crate" = "${CRATES[-1]}" ] || wait_for_index "$crate" "$VERSION"
done

if [ "$SKIP_NPM" = no ]; then
  step "npm へ公開"
  # ブラウザとバンドラで要る形が違う。npm にはバンドラ向けを出す。
  wasm-pack build "$WASM_CRATE" --target bundler --out-dir pkg-npm --release >/dev/null
  (
    cd "$WASM_CRATE/pkg-npm"
    npm pkg set \
      name="$NPM_PACKAGE" \
      version="$VERSION" \
      description="NounSQL: a DSL for database schema design, compiled to PostgreSQL DDL." \
      homepage="https://misebox.github.io/nounsql" \
      repository.type="git" \
      repository.url="git+https://github.com/misebox/nounsql.git"
    npm publish --access public
  )
fi

step "push"
git push origin HEAD
git push origin "$TAG"

cat <<EOF

完了。

  crates.io  https://crates.io/crates/nounsql
  npm        https://www.npmjs.com/package/$NPM_PACKAGE
  CI         https://github.com/misebox/nounsql/actions

タグの push で CI がバイナリをビルドし、GitHub Release を作る。
EOF
